# ============================================================
#  ACADEMY 21 — Variables d'environnement
# ============================================================
# En dev : copie ce fichier vers .env.local et remplis les valeurs.
# En prod : renseigne les mêmes clés dans Vercel → Project Settings
#           → Environment Variables (Production + Preview + Development).

# ---------- BASE DE DONNÉES (obligatoire) ----------
# Récupère la connection string sur https://console.neon.tech
# (Dashboard → ton projet → Connection Details → "Pooled connection")
DATABASE_URL=postgres://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ---------- AUTH (obligatoire) ----------
# Génère une valeur aléatoire : openssl rand -base64 48
JWT_SECRET=change-me-avec-une-vraie-valeur-aleatoire

# Compte admin créé au premier `npm run db:init`
ADMIN_EMAIL=admin@academy21france.fr
ADMIN_PASSWORD=ChangeMe123!

# ---------- STRIPE (optionnel, active les paiements CB) ----------
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# https://dashboard.stripe.com/webhooks → endpoint /api/payments/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# ---------- PAYPAL (optionnel, active les paiements PayPal) ----------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# 'sandbox' pour tester, 'live' en production
PAYPAL_ENV=sandbox
